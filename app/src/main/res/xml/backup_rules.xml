<?xml version="1.0" encoding="utf-8"?>
<!--
  Android backup exclusions (product brief section 42).

  Excluded, and why:
    credentials.*   BYOK API keys. Keystore-wrapped, but the wrapped blob must
                    not travel to another device where it is useless at best and
                    an attack surface at worst.
    history.*       Dictated text, when the user has opted into history.
    scratchpad.*    Any persisted draft.
    models/         Multi-hundred-megabyte model files; re-downloadable, and
                    backing them up would defeat checksum pinning on restore.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="credentials.xml" />
    <exclude domain="sharedpref" path="credentials.preferences_pb" />
    <exclude domain="file" path="datastore/credentials.preferences_pb" />
    <exclude domain="file" path="history.db" />
    <exclude domain="file" path="scratchpad" />
    <exclude domain="file" path="models" />
    <exclude domain="database" path="history.db" />
</full-backup-content>
