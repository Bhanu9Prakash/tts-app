<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ equivalent of backup_rules.xml. Same exclusions, applied to
     both cloud backup and device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="credentials.xml" />
        <exclude domain="file" path="datastore/credentials.preferences_pb" />
        <exclude domain="file" path="history.db" />
        <exclude domain="file" path="scratchpad" />
        <exclude domain="file" path="models" />
        <exclude domain="database" path="history.db" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="credentials.xml" />
        <exclude domain="file" path="datastore/credentials.preferences_pb" />
        <exclude domain="file" path="history.db" />
        <exclude domain="file" path="scratchpad" />
        <exclude domain="file" path="models" />
        <exclude domain="database" path="history.db" />
    </device-transfer>
</data-extraction-rules>
